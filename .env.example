# stock-mcp 環境變數範例
# 複製為 .env 後填入實際值;.env 已列入 .gitignore,不可提交進版本控制。

APP_ENV=development
HOST=127.0.0.1
PORT=3000
MCP_PATH=/mcp
TRUST_PROXY=false

# 請使用獨立、最小權限的 PostgreSQL「唯讀」帳號(建立方式見 README)
DATABASE_URL=postgresql://stock_mcp_reader:CHANGE_ME@127.0.0.1:5432/stock
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000

# 所有 MCP 請求都必須帶 Authorization: Bearer <MCP_API_KEY>
MCP_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# rate limit:每個 API key 與來源 IP 在視窗內的最大請求數
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# debug / info / warn / error
LOG_LEVEL=info
