# stock-mcp 環境變數範例
# 複製為 .env 後填入實際值;.env 已列入 .gitignore,不可提交進版本控制。

APP_ENV=development
HOST=127.0.0.1
PORT=9005
MCP_PATH=/mcp
TRUST_PROXY=false

# 前方有幾層會自行附加 X-Forwarded-For 的受信任代理(只在 TRUST_PROXY=true
# 時有意義)。單一 Nginx = 1;CDN 再加一層 Nginx = 2。
# 這個值必須與實際部署拓撲一致:設得太大會讓 rate limit 依據一個
# 用戶端可偽造的 IP,等於完全失效。詳見 README「反向代理」。
TRUSTED_PROXY_HOPS=1

# 資料來源：過渡期可選 db 或 api；正式切換後建議使用 api。
DATA_SOURCE=api
# db 模式才需要資料庫連線字串。
DATABASE_URL=postgresql://stock_mcp_reader:CHANGE_ME@127.0.0.1:5432/stock
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=5000
# api 模式連往 stock_rust 的內網 Data API，金鑰與 MCP_API_KEY 必須不同。
STOCK_RUST_API_BASE_URL=http://127.0.0.1:9002
STOCK_RUST_API_KEY=CHANGE_ME_TO_A_DIFFERENT_SECRET
API_TIMEOUT_MS=5000

# 相容性 bootstrap：只有 API key SQLite 尚無任何資料時才會匯入一次。
# 匯入完成後 SQLite 是唯一主要來源；可從部署環境移除此變數。
# 所有 MCP 請求仍沿用 Authorization: Bearer <api-key>。
MCP_API_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# API Key 管理資料庫。Docker 請使用 /data/mcp-api-keys.db 並掛載 volume。
MCP_API_KEY_DB_PATH=data/mcp-api-keys.db

# HMAC-SHA-256 server-side pepper，至少 32 bytes。必須由 secret manager
# 注入，不可寫進 Git；遺失或改變後，既有 API Key 將無法驗證。
MCP_API_KEY_PEPPER=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_BYTES

# 管理 API 專用 Bearer token，至少 32 bytes，不可與 MCP_API_KEY 共用。
# 管理頁不會將此值寫入 localStorage/sessionStorage。
MCP_ADMIN_TOKEN=CHANGE_ME_TO_A_DIFFERENT_ADMIN_SECRET_32_BYTES

# 額外信任的跨來源 Origin(逗號分隔,例如 https://a.example,https://b.example)。
# 服務會擋下 Origin 與自身 Host 不符的請求;非瀏覽器的 MCP 用戶端
# (Claude Desktop、Claude Code 等)不會送出 Origin,完全不受影響,
# 因此絕大多數部署都可以留空。只有在「前方反向代理會改寫 Host」或
# 「需要讓特定網頁前端跨網域呼叫」時才需要設定。
MCP_TRUSTED_ORIGINS=

# rate limit:每個 API key 與來源 IP 在視窗內的最大請求數
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60

# debug / info / warn / error
LOG_LEVEL=info
